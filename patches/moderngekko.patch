diff --git a/tests/native_only_run_test.cpp b/tests/native_only_run_test.cpp
new file mode 100644
index 0000000..7a71050
--- /dev/null
+++ b/tests/native_only_run_test.cpp
@@ -0,0 +1,202 @@
+#include "moderngekko/runtime.hpp"
+
+#include "Common/CommonTypes.h"
+#include "Core/HW/CPU.h"
+#include "Core/PowerPC/JitInterface.h"
+#include "Core/PowerPC/PowerPC.h"
+#include "Core/PowerPC/StaticRecomp/StaticRecompCore.h"
+#include "Core/System.h"
+#include "Core/PowerPC/StaticRecomp/StaticRecompABI.h"
+
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+#include <cstdio>
+#include <filesystem>
+#include <fstream>
+#include <iterator>
+#include <thread>
+#include <vector>
+
+#ifndef SMG2_TEST_GAME_ROOT
+#error SMG2_TEST_GAME_ROOT must point at the extracted SB4E01 data root
+#endif
+
+namespace
+{
+enum class Case { DeclineEntry, UncoveredAfterEntry, PhysicalVector, PhysicalSMC, Fallback };
+std::atomic<Case> s_case{Case::DeclineEntry};
+std::atomic<unsigned> s_dispatches{0};
+std::array<ModernGekkoRange, 2> s_ranges{{{0x500, 0x504}, {0x80004050, 0x80004054}}};
+std::array<std::uint64_t, 2> s_hashes{};
+ModernGekkoModuleDesc s_module{};
+std::filesystem::path s_test_root;
+
+bool PrepareRoot()
+{
+  s_test_root = SMG2_TEST_GAME_ROOT;
+  return std::filesystem::is_directory(s_test_root / "files") &&
+         std::filesystem::is_regular_file(s_test_root / "sys/main.dol");
+}
+
+std::uint64_t Hash(const std::uint8_t* bytes, std::size_t size)
+{
+  std::uint64_t hash = 0xCBF29CE484222325ull;
+  for (std::size_t i = 0; i < size; ++i) { hash ^= bytes[i]; hash *= 0x100000001B3ull; }
+  return hash;
+}
+
+int Dispatch(CPUState* cpu, std::uint32_t address)
+{
+  const unsigned call = s_dispatches.fetch_add(1) + 1;
+  std::fprintf(stderr, "native-only dispatch case=%d call=%u pc=%08x\n", int(s_case.load()), call, address);
+  switch (s_case.load())
+  {
+  case Case::DeclineEntry:
+    return 0;
+  case Case::UncoveredAfterEntry:
+    if (call == 1) { cpu->pc = 0x508; return 1; }
+    return 0;
+  case Case::PhysicalVector:
+    if (call == 1 && address == 0x80004050)
+    {
+      cpu->ram[0x500] = 0x60;
+      cpu->ram[0x501] = 0;
+      cpu->ram[0x502] = 0;
+      cpu->ram[0x503] = 0;
+      cpu->pc = 0x500;
+      return 1;
+    }
+    if (call == 2 && address == 0x500) { cpu->pc = 0x508; return 1; }
+    return 0;
+  case Case::PhysicalSMC:
+    if (call == 1 && address == 0x80004050)
+    {
+      cpu->ram[0x500] = 0x60; cpu->ram[0x501] = 0; cpu->ram[0x502] = 0; cpu->ram[0x503] = 0;
+      cpu->pc = 0x500;
+      return 1;
+    }
+    if (call == 2 && address == 0x500)
+    {
+      cpu->ram[0x503] = 1;
+      constexpr std::uint8_t kICBI = 3; // PPC_CACHE_ICBI in GXRuntime/core/cpu.h
+      cpu->cache_control(cpu, kICBI, 0x80000500, 0x500);
+      cpu->pc = 0x500;
+      return 1;
+    }
+    return 0;
+  case Case::Fallback:
+    cpu->instruction_fallback(cpu, 0x7C000000u, address);
+    return 1;
+  }
+  return 0;
+}
+
+bool PrepareDescriptor()
+{
+  const auto dol_path = s_test_root / "sys/main.dol";
+  std::ifstream input(dol_path, std::ios::binary);
+  std::vector<std::uint8_t> dol((std::istreambuf_iterator<char>(input)), {});
+  if (!input && dol.empty()) { std::fprintf(stderr, "fixture DOL unreadable: %s\n", dol_path.c_str()); return false; }
+  std::uint32_t entry = 0;
+  for (int i = 0; i < 4; ++i) entry = (entry << 8) | dol[0xE0 + i];
+  if (entry != 0x80004050) { std::fprintf(stderr, "unexpected SB4E01 entry 0x%08X\n", entry); return false; }
+  std::uint32_t file_offset = 0;
+  for (std::size_t section = 0; section < 7; ++section)
+  {
+    std::uint32_t off = 0, addr = 0, size = 0;
+    for (int i = 0; i < 4; ++i) { off = (off << 8) | dol[section * 4 + i]; addr = (addr << 8) | dol[0x48 + section * 4 + i]; size = (size << 8) | dol[0x90 + section * 4 + i]; }
+    if (entry >= addr && entry + 4 <= addr + size) { file_offset = off + entry - addr; break; }
+  }
+  if (!file_offset || file_offset + 4 > dol.size()) { std::fprintf(stderr, "fixture DOL entry section missing offset=%x size=%zu\n", file_offset, dol.size()); return false; }
+  constexpr std::array<std::uint8_t, 4> physical_word{0x60, 0, 0, 0};
+  s_hashes[0] = Hash(physical_word.data(), physical_word.size());
+  s_hashes[1] = Hash(dol.data() + file_offset, 4);
+  s_module = {};
+  s_module.abi_version = MODERNGEKKO_MODULE_ABI_VERSION;
+  s_module.cpu_abi_version = MODERNGEKKO_CPU_ABI_VERSION;
+  s_module.cpu_state_size = sizeof(CPUState);
+  std::memcpy(s_module.game_id, "SB4E01", 7);
+  s_module.entry_point = entry;
+  s_module.dispatch = Dispatch;
+  s_module.code_ranges = s_ranges.data();
+  s_module.num_code_ranges = s_ranges.size();
+  s_module.chunk_ranges = s_ranges.data();
+  s_module.num_chunk_ranges = s_ranges.size();
+  s_module.chunk_hashes = s_hashes.data();
+  return true;
+}
+
+bool RunCase(Case which, unsigned expected_calls, std::uint32_t expected_stop_pc)
+{
+  moderngekko::RuntimeConfig config;
+  config.game_root = s_test_root;
+  config.user_directory = std::filesystem::temp_directory_path() /
+                          ("smg2-native-only-run-test-" + std::to_string(int(which)));
+  config.headless = true;
+  config.show_fps_in_title = false;
+  config.module = moderngekko::ModuleSource::AttachedDescriptor(&s_module);
+  config.allow_interpreter = false;
+  std::fprintf(stderr, "native-only test: Runtime::Create starting case=%d\n", int(which));
+  auto created = moderngekko::Runtime::Create(std::move(config));
+  if (!created) { std::fprintf(stderr, "Runtime::Create failed: %s\n", created.error->message.c_str()); return false; }
+  std::fprintf(stderr, "native-only test: Runtime::Create ready case=%d\n", int(which));
+  s_case = which;
+  s_dispatches = 0;
+  auto runtime = std::move(created.runtime);
+  moderngekko::RuntimeRunResult result;
+  std::thread runner([&] { std::fprintf(stderr, "native-only test: Run starting case=%d\n", int(which)); result = runtime->Run(); std::fprintf(stderr, "native-only test: Run returned case=%d\n", int(which)); });
+  const auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds(20);
+  auto& system = Core::System::GetInstance();
+  bool stopped_at_guard = false;
+  bool no_jit = false;
+  std::uint32_t stop_pc = 0;
+  while (std::chrono::steady_clock::now() < deadline)
+  {
+    if (s_dispatches.load() >= expected_calls && system.GetCPU().GetState() == CPU::State::Stepping)
+    {
+      auto* core = dynamic_cast<StaticRecompCore*>(system.GetJitInterface().GetCore());
+      no_jit = core && core->GetExceptionCheckTarget() == core;
+      stop_pc = system.GetPowerPC().GetPPCState().pc;
+      stopped_at_guard = true;
+      break;
+    }
+    std::this_thread::sleep_for(std::chrono::milliseconds(2));
+  }
+  const unsigned observed = s_dispatches.load();
+  runtime->RequestStop();
+  runner.join();
+  const bool ok = observed == expected_calls && stopped_at_guard && no_jit &&
+                  stop_pc == expected_stop_pc && !result.error;
+  if (!ok) std::fprintf(stderr, "case %d observed %u dispatches (expected %u), guard=%d no_jit=%d stop_pc=%08x expected=%08x\n", int(which), observed, expected_calls, stopped_at_guard, no_jit, stop_pc, expected_stop_pc);
+  return ok;
+}
+} // namespace
