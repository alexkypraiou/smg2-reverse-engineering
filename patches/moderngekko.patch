+  setenv("MODERNGEKKO_STATICRECOMP", "0", 1);
+  if (!PrepareRoot() || !PrepareDescriptor()) { std::fprintf(stderr, "could not prepare SB4E01 descriptor\n"); return 1; }
+  if (argc == 2)
+  {
+    const int selected = std::atoi(argv[1]);
+    if (selected == 0) return RunCase(Case::DeclineEntry, 1, 0x80004050) ? 0 : 2;
+    if (selected == 1) return RunCase(Case::UncoveredAfterEntry, 1, 0x508) ? 0 : 2;
+    if (selected == 2) return RunCase(Case::PhysicalVector, 2, 0x508) ? 0 : 2;
+    if (selected == 3) return RunCase(Case::PhysicalSMC, 2, 0x500) ? 0 : 2;
+    if (selected == 4) return RunCase(Case::Fallback, 1, 0x80004050) ? 0 : 2;
+    return 91;
+  }
+  const bool decline = RunCase(Case::DeclineEntry, 1, 0x80004050);
+  const bool uncovered = RunCase(Case::UncoveredAfterEntry, 1, 0x508);
+  const bool physical = RunCase(Case::PhysicalVector, 2, 0x508);
+  const bool physical_smc = RunCase(Case::PhysicalSMC, 2, 0x500);
+  const bool fallback = RunCase(Case::Fallback, 1, 0x80004050);
+  return decline && uncovered && physical && physical_smc && fallback ? 0 : 2;
