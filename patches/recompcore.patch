+// Native SMG2 boot profile. The disc's apploader is PPC code outside the AOT
+// module; running it through SingleStep would violate the native-only path.
+// Read the verified DOL and its disc metadata directly on the host instead.
+// IOS, DI and ES initialization still follows EmulatedBS2_Wii below.
+bool LoadNativeSmg2Disc(Core::System& system, const DiscIO::VolumeDisc& volume)
+{
+  constexpr u32 kDolSize = 7546080;
+  constexpr u32 kMem1End = 0x81800000;
+  constexpr u32 kArenaHi = 0x817A0000;  // Excludes the fixed AOT HomeButton RSO.
+  constexpr u32 kRsoEnd = 0x817C3600;
+  constexpr u32 kBi2Size = 0x2000;
+  constexpr u32 kBi2Address = kMem1End - kBi2Size;
+  const auto reject = [](const char* reason) {
+    std::fprintf(stderr, "[native-only] direct disc boot rejected: %s\n", reason);
+    return false;
+  };
+  if (volume.GetGameID() != "SB4E01" || volume.GetRevision().value_or(0xffff) != 0)
+    return reject("only the pinned SB4E01 revision 0 profile is implemented");
+  const auto partition = volume.GetGamePartition();
+  const auto dol_word = volume.ReadSwapped<u32>(0x420, partition);
+  const auto fst_word = volume.ReadSwapped<u32>(0x424, partition);
+  const auto fst_size_word = volume.ReadSwapped<u32>(0x428, partition);
+  if (!dol_word || !fst_word || !fst_size_word || !*dol_word || !*fst_word ||
+      !*fst_size_word || *fst_size_word > 0x80000)
+    return reject("invalid DOL/FST partition header");
+  const u32 fst_size = *fst_size_word * 4;
+  const u32 fst_address = (kBi2Address - fst_size) & ~31u;
+  if (fst_address < kRsoEnd || system.GetMemory().GetRamSizeReal() != 0x1800000)
+    return reject("FST or memory layout conflicts with the native profile");
+
+  std::vector<u8> dol(kDolSize);
+  std::vector<u8> fst(fst_size);
+  std::array<u8, kBi2Size> bi2{};
+  if (!volume.Read(static_cast<u64>(*dol_word) * 4, dol.size(), dol.data(), partition) ||
+      !volume.Read(static_cast<u64>(*fst_word) * 4, fst.size(), fst.data(), partition) ||
+      !volume.Read(0x440, bi2.size(), bi2.data(), partition))
+    return reject("could not read complete DOL/FST/BI2 data");
+  constexpr Common::SHA1::Digest kMainSha1 = {0x7d, 0x79, 0x81, 0x08, 0x89, 0x82, 0x4e,
+                                           0xdd, 0x01, 0xc4, 0xff, 0x02, 0x62, 0x47,
+                                           0x13, 0x06, 0x0a, 0x69, 0x81, 0x8c};
+  if (Common::SHA1::CalculateDigest(dol) != kMainSha1)
+    return reject("main.dol does not match the AOT SB4E01 revision 0 input");
+  const auto read_be32 = [](const u8* p) {
+    return (static_cast<u32>(p[0]) << 24) | (static_cast<u32>(p[1]) << 16) |
+           (static_cast<u32>(p[2]) << 8) | p[3];
+  };
+  if (fst.size() < 12 || read_be32(fst.data()) != 0x01000000 ||
+      read_be32(fst.data() + 8) < 1 ||
+      static_cast<u64>(read_be32(fst.data() + 8)) * 12 > fst.size())
+    return reject("invalid FST root or entry count");
+  const u32 bss_start = read_be32(dol.data() + 0xd8);
+  const u32 bss_size = read_be32(dol.data() + 0xdc);
+  if (bss_start < 0x80004000 || static_cast<u64>(bss_start) + bss_size > kArenaHi)
+    return reject("DOL BSS conflicts with reserved native memory");
+  DolReader reader(std::move(dol));
+  if (!reader.IsValid() || !reader.IsWii() || reader.GetEntryPoint() != 0x80004050)
+    return reject("invalid native DOL entry point or CPU profile");
+
+  auto& memory = system.GetMemory();
+  // The DOL aggregate BSS overlaps initialized data in this title. Clear it
+  // FIRST, then copy the initialized sections so their bytes survive.
+  memory.Memset(bss_start, 0, bss_size);
+  if (!reader.LoadIntoMemory(system))
+    return reject("DOL section loading failed");
+  memory.CopyToEmu(fst_address, fst.data(), fst.size());
+  memory.CopyToEmu(kBi2Address, bi2.data(), bi2.size());
+  memory.Write_U32(kArenaHi, 0x34);
+  // Wii OSInit prefers IOS's arena end at 0x3110 over BootInfo::arenaHi.
+  // BootIOS initializes that field to 0x81800000, so cap BOTH sources.
+  memory.Write_U32(kArenaHi, 0x3110);
+  memory.Write_U32(fst_address, 0x38);
+  memory.Write_U32(fst_size, 0x3c);
+  memory.Write_U32(kBi2Address, 0xf4);
+  memory.Write_U32(memory.Read_U32(0x3140), 0x3188);
+  system.GetPPCState().pc = reader.GetEntryPoint();
+  std::fprintf(stderr,
+               "[native-only] host-loaded SB4E01 DOL entry=%08x FST=%08x+%x BI2=%08x arenaHi=%08x; no PPC apploader executed\n",
+               reader.GetEntryPoint(), fst_address, fst_size, kBi2Address, kArenaHi);
+  return true;
+}
