+Shake::StateData Shake::GetState(const InputOverrideFunction& override_func) const
+{
+  StateData result = GetState();
+  if (!override_func)
+    return result;
+
+  for (std::size_t i = 0; i != result.data.size(); ++i)
+  {
+    if (const std::optional<ControlState> override_state =
+            override_func(name, controls[i]->name, result.data[i]))
+    {
+      result.data[i] = *override_state;
+    }
+  }
+  return result;
+}
